BOT_TOKEN=YOUR_BOT_TOKEN
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
OPENAI_TOKEN=your_openai_token
# Optional: Assistants API id for cogs/bot-dm.py (defaults to built-in if unset)
OPENAI_ASSISTANT_ID=asst_your_assistant_id
# Optional: model name used only for tiktoken counts in DMs (default gpt-4o-mini)
OPENAI_TOKEN_COUNT_MODEL=gpt-4o-mini
PPLX_TOKEN=your_pplx_token
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key
GOOGLE_AI_API_KEY=your_google_ai_api_key
# =====================================================================
# Nyanjou – GPT-Live voice assistant + T3 Code (see docs/nyanjou-integration.md)
# =====================================================================
# Discord bot token: BOT_TOKEN above is used; DISCORD_BOT_TOKEN works as an alias.
#DISCORD_BOT_TOKEN=

# OpenAI API key (platform.openai.com, billing enabled). A ChatGPT Plus/Pro
# subscription does NOT grant API access. Falls back to OPENAI_TOKEN above.
OPENAI_API_KEY=
# GPT-Live model and voice (/model and /voice switch them per server)
NYANJOU_VOICE_MODEL=gpt-live-1.1
NYANJOU_VOICE_NAME=marin
# Responses model GPT-Live delegates tool work to (calls T3 Code)
NYANJOU_BACKEND_MODEL=gpt-5.6-luna
NYANJOU_BACKEND_REASONING=low
NYANJOU_BACKEND_WEB_SEARCH=true
NYANJOU_NAME=Nyanjou
NYANJOU_LANGUAGE=de
#NYANJOU_EXTRA_INSTRUCTIONS=

# Authorization: bot owner always allowed; others via /usr-mgmt add_user (allowed_users.sqlite)
NYANJOU_OWNER_ID=
#NYANJOU_ALLOWED_USERS_DB=allowed_users.sqlite
# Let non-authorized people in the channel talk with Nyanjou (they can never start tasks)
NYANJOU_ALLOW_GUEST_CONVERSATION=true
# floor = one speaker at a time (reliable attribution, recommended) | mix = mix everyone
NYANJOU_SPEAKER_MODE=floor
NYANJOU_ATTRIBUTION_WINDOW_MS=8000
# If anyone else spoke within this longer window, the speaker must confirm the assembled task
NYANJOU_ATTRIBUTION_CONTEXT_MS=60000
NYANJOU_ATTRIBUTION_TOLERANCE_MS=600
NYANJOU_FLOOR_RELEASE_MS=700
NYANJOU_VAD_THRESHOLD_DBFS=-45
NYANJOU_BARGE_IN=true
NYANJOU_BARGE_IN_MS=160
# Leave the channel after this many seconds without speech (0 = never)
NYANJOU_IDLE_TIMEOUT_S=900
# Where to post finished task results: channel | dm | none
NYANJOU_RESULTS_TO=channel

# Voice bridge (Node >= 22.12, `npm ci` in bridge/). Started automatically by the bot.
NYANJOU_BRIDGE_AUTOSTART=true
NYANJOU_BRIDGE_HOST=127.0.0.1
NYANJOU_BRIDGE_PORT=8765
# Random per start if empty; required when the bridge runs separately (AUTOSTART=false)
NYANJOU_BRIDGE_TOKEN=
#NYANJOU_BRIDGE_NODE=node

# T3 Code MCP (Settings → Environments → Copy MCP URL). Sign in once with:
#   uv run python tools/nyanjou_t3_login.py
T3_MCP_URL=
# Default T3 project for tasks (the login script lists IDs)
T3_PROJECT_ID=
#T3_MCP_TOKEN_FILE=data/t3_oauth.json
# Only for a token issued by T3's official sign-in; normally leave empty and use the login script
#T3_MCP_ACCESS_TOKEN=
# Empty = T3 default | root | worktree (+ T3_BASE_REF, e.g. origin/main)
#T3_WORKSPACE_STRATEGY=
#T3_BASE_REF=
# Empty = inherit the access level approved for the bot (approval-required|auto-accept-edits|auto|full-access)
#T3_RUNTIME_MODE=
# Allow "new_project" tasks in a fresh T3 scratch folder
T3_ALLOW_SCRATCH=true
#T3_WAIT_SLICE_MS=25000

# Task scheduling
NYANJOU_MAX_PARALLEL_TASKS=4
NYANJOU_TASK_TIMEOUT_S=7200
#NYANJOU_TASKS_DB=data/nyanjou_tasks.sqlite

# Verbose logs for Nyanjou (transcripts at DEBUG, bridge debug output)
NYANJOU_DEBUG=false
